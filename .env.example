# Copy to .env and fill in. Never commit .env.
DOMAIN=paralympia.example.cz

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=paralympia.example.cz
# Who gets an email about every new registration (comma separated).
DJANGO_ADMIN_EMAILS=

POSTGRES_DB=paralympia
POSTGRES_USER=paralympia
POSTGRES_PASSWORD=change-me

# Gmail: turn on 2-step verification, then create an app password at https://myaccount.google.com/apppasswords
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application).
# Authorized redirect URI: https://<DOMAIN>/accounts/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare dashboard > Turnstile > Add widget (free). Leave empty to skip the check.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
